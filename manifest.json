{
  "manifest_version": 3,
  "name": "Smart Time Converter",
  "version": "1.0.0",
  "description": "Converts selected or detected time strings to your local or chosen timezone.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "options.html",
    "default_title": "Smart Time Converter Settings"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["luxon.min.js", "content.js"],
      "css": ["styles.css"]
    }
  ]
}